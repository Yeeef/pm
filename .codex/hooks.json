{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "pm prime --rules 1 --hook-json",
            "statusMessage": "Loading pm rules (1 of 3)",
            "type": "command",
            "timeout": 30
          },
          {
            "command": "pm prime --rules 2 --hook-json",
            "statusMessage": "Loading pm rules (2 of 3)",
            "type": "command",
            "timeout": 30
          },
          {
            "command": "pm prime --rules 3 --hook-json",
            "statusMessage": "Loading pm rules (3 of 3)",
            "type": "command",
            "timeout": 30
          },
          {
            "command": "pm prime --state --hook-json",
            "statusMessage": "Loading pm init, pm where and pm show",
            "type": "command",
            "timeout": 30
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "pm prime --rules 1 --hook-json",
            "statusMessage": "Loading pm rules (1 of 3)",
            "type": "command",
            "timeout": 15
          },
          {
            "command": "pm prime --rules 2 --hook-json",
            "statusMessage": "Loading pm rules (2 of 3)",
            "type": "command",
            "timeout": 15
          },
          {
            "command": "pm prime --rules 3 --hook-json",
            "statusMessage": "Loading pm rules (3 of 3)",
            "type": "command",
            "timeout": 15
          },
          {
            "command": "pm prime --subagent --hook-json",
            "statusMessage": "Loading pm's git rule for agents",
            "type": "command",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "pm hook owner-request || exit 1",
            "statusMessage": "Checking for owner requests asked only in chat",
            "type": "command",
            "timeout": 30
          },
          {
            "command": "pm hook stop || exit 1",
            "statusMessage": "Checking for uncommitted records",
            "type": "command",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
